# --- Web research (optional — paste https links in /chat; no search key needed) ---
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# --- LLM (heuristic mind works with no API keys) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLE_LLM_PROVIDER=openai
OLLE_DECIDE_MODEL=gpt-4o-mini
OLLE_SPEAK_MODEL=gpt-4o-mini

# Anthropic-only model overrides (when OLLE_LLM_PROVIDER=anthropic):
# OLLE_DECIDE_MODEL=claude-haiku-4-5-20251001
# OLLE_SPEAK_MODEL=claude-sonnet-4-5-20250929

# --- William identity ---
WILLIAM_EMAIL=you@example.com
OLLE_INBOUND_ALLOWLIST=you@example.com

# --- Outbound email (all three required for real Resend; else mock logs “WOULD SEND”) ---
RESEND_API_KEY=
OLLE_EMAIL_FROM=olle@your-domain.com

# --- Runtime ---
OLLE_STATE_PATH=.olle-state.json
OLLE_TICK_MS=30000
OLLE_INBOUND_PORT=8787
OLLE_INBOUND_PATH=/webhooks/email/inbound
OLLE_VERBOSE=0

# --- Phase 1: email caps & quiet hours (Europe/Oslo default) ---
OLLE_QUIET_HOURS=22:00-08:00
OLLE_QUIET_TZ=Europe/Oslo

# Optional: allow POST /api/message from non-localhost (Bearer token)
# OLLE_MESSAGE_TOKEN=

# --- LAN / Pi hosting (William-only login; required when OLLE_PUBLIC=1) ---
# OLLE_PUBLIC=1
# OLLE_AUTH_PASSWORD=
# OLLE_SESSION_SECRET=
# OLLE_BIND_HOST=0.0.0.0
